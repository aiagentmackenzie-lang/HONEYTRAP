# HONEYTRAP API Configuration
# Copy this file to .env and fill in values

# Required: Set a strong token for API authentication.
# Leave empty to disable auth (dev mode only - NOT for production).
API_TOKEN=

# Database
DATABASE_URL=postgres://honeytrap:honeytrap_dev@localhost:5432/honeytrap

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info